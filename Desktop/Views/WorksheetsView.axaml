<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.ViewModels"
             x:Class="Desktop.Views.WorksheetsView"
             x:DataType="vm:WorksheetsViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Classes="liis-secondary" Content="← Назад" Command="{Binding BackCommand}"/>
            <TextBlock Classes="page-title" Text="Рабочие листы" Margin="0"/>
            <Separator Width="1" Height="24" Background="{StaticResource LiisMutedBrush}" VerticalAlignment="Center" Margin="4,0"/>
            <TextBlock Text="{Binding TripodName}" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource LiisMutedBrush}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{StaticResource LiisMutedBrush}" Margin="0,8,0,0"/>
        <Border Classes="liis-card" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <DataGrid x:Name="WorksheetGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0">
                </DataGrid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>