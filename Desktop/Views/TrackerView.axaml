<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.ViewModels"
             x:Class="Desktop.Views.TrackerView"
             x:DataType="vm:TrackerViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="Трекер"/>
        <Grid ColumnDefinitions="320,*" DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border Classes="liis-card" Margin="0,0,12,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Найти по:" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding SearchModes}" SelectedItem="{Binding SelectedSearchMode}"/>
                    <TextBox Classes="liis-input" Watermark="IDS" Text="{Binding IdsFilter}"/>
                    <TextBox Classes="liis-input" Watermark="Комментарий" Text="{Binding Comment}" AcceptsReturn="True" Height="80"/>
                    <Button Classes="liis-primary" Content="Найти" Command="{Binding SearchCommand}"/>
                </StackPanel>
            </Border>
            <Border Classes="liis-card" Padding="0" Grid.Column="1">
                <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                        <DataGridTextColumn Header="IDS" Binding="{Binding Ids}" Width="*"/>
                        <DataGridTextColumn Header="Ф. И. О." Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="ЛПУ" Binding="{Binding Lpu}" Width="*"/>
                        <DataGridTextColumn Header="Вид материала" Binding="{Binding MaterialKind}" Width="*"/>
                        <DataGridTextColumn Header="Тип материала" Binding="{Binding MaterialType}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Измерения" Padding="16,8" CornerRadius="10"/>
            <Button Content="Динамика" Padding="16,8" CornerRadius="10" Background="Transparent"/>
            <Button Content="Работы" Padding="16,8" CornerRadius="10" Background="Transparent"/>
            <Button Content="Услуги" Padding="16,8" CornerRadius="10" Background="Transparent"/>
        </StackPanel>
        <Border Classes="liis-card" Padding="0">
            <DataGrid ItemsSource="{Binding Measurements}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Анализ" Binding="{Binding Analysis.AnalysisName}" Width="*"/>
                    <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
