<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.ViewModels"
             x:Class="Desktop.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="Результаты"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button Classes="liis-secondary" Content="Распечатать" Padding="20,12"/>
            <Button Classes="liis-secondary" Content="Отправить" Padding="20,12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="Напечатанные" Command="{Binding SetFilterCommand}" CommandParameter="0" Padding="14,8" CornerRadius="10"/>
            <Button Content="Ненапечатанные" Command="{Binding SetFilterCommand}" CommandParameter="1" Padding="14,8" CornerRadius="10"/>
            <Button Content="Отправленные" Command="{Binding SetFilterCommand}" CommandParameter="2" Padding="14,8" CornerRadius="10"/>
        </StackPanel>
        <Border Classes="liis-card" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IDS" Binding="{Binding Ids}" Width="*"/>
                    <DataGridTextColumn Header="Ф. И. О." Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="ЛПУ" Binding="{Binding Lpu}" Width="*"/>
                    <DataGridTextColumn Header="Врач" Binding="{Binding Doctor}" Width="*"/>
                    <DataGridTextColumn Header="Тип материала" Binding="{Binding MaterialType}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
