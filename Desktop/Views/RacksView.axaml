<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.ViewModels"
             xmlns:conv="using:Desktop.Converters"
             xmlns:prims="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
             x:Class="Desktop.Views.RacksView"
             x:DataType="vm:RacksViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="page-title" Text="Штативы"/>
        <Grid ColumnDefinitions="*,280" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TabControl Grid.Column="0" ItemsSource="{Binding Tripods}" SelectedItem="{Binding SelectedTripod}" Margin="0,0,12,12">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TripodName}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate/>
                    </TabControl.ContentTemplate>
                </TabControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBox Width="180" Watermark="Название штатива" Text="{Binding NewTripodName}"/>
                    <Button Classes="liis-primary" Content="Добавить" Command="{Binding CreateTripodCommand}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Grid.Column="0" Classes="liis-card" Margin="0,0,16,0" Padding="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RackCells}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <prims:UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding MaterialType, Converter={x:Static conv:MaterialTypeToBrushConverter.Instance}}"
                                        CornerRadius="6" Margin="0,0,5,5" Width="120" Height="70"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        PointerPressed="OnCellPointerPressed"
                                        Cursor="Hand"
                                        BorderBrush="{Binding IsSelected, Converter={x:Static conv:BoolToSelectionColorConverter.Instance}}"
                                        BorderThickness="{Binding IsSelected, Converter={x:Static conv:IsSelectedToThicknessConverter.Instance}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PatientName}" HorizontalAlignment="Center"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   MaxLines="2" IsVisible="{Binding IsOccupied}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="12">
                <Border Classes="liis-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Сканирование пробирки" FontWeight="SemiBold"/>
                        
                        <TextBlock Text="Выберите ячейку на штативе, затем отсканируйте или введите штрих-код пробирки"
                                   TextWrapping="Wrap" FontSize="11"/>
                        
                        <TextBox Watermark="Штрих-код пробирки" Text="{Binding ScannedBarcode, Mode=TwoWay}"
                                 AcceptsReturn="False"/>
                        
                        <Button Content="Привязать пробирку" Command="{Binding ScanBarcodeCommand}"
                                HorizontalAlignment="Stretch" Classes="liis-primary"
                                IsEnabled="{Binding SelectedCell, Converter={x:Static conv:ReferenceNotNullConverter.Instance}}"/>
                        
                        <TextBlock Text="{Binding ScannedPatientInfo}" TextWrapping="Wrap" FontSize="12"
                                   IsVisible="{Binding ScannedPatientInfo, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"/>
                        
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{Binding StatusMessage, Converter={x:Static conv:StatusMessageBrushConverter.Instance}}"/>
                    </StackPanel>
                </Border>
                
                <Border Classes="liis-card">
                    <StackPanel>
                        <TextBlock Text="Приоритет" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Priorities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Margin="0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <Button Classes="liis-primary" Content="Рабочие листы" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                Command="{Binding OpenWorksheetsCommand}" HorizontalAlignment="Stretch" Height="115"/>
                <ComboBox ItemsSource="{Binding GridSizeOptions}" 
                SelectedItem="{Binding SelectedGridSizeOption}" 
                PlaceholderText="Размер штатива" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>